# Firebase Configuration for Math Made Easy
# Replace these values with your Firebase Project credentials from https://console.firebase.google.com

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=math-made-easy.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=math-made-easy
VITE_FIREBASE_STORAGE_BUCKET=math-made-easy.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
